# Copy to .env.production (git-ignored). Read by `vite build` and compiled into the client bundle,
# so these are public values - never put secrets here. Separate from .dev.vars (Worker runtime).

# Apollo's self-hosted Swetrix API endpoint, including the `/log` path.
VITE_APOLLO_SWETRIX_API_URL=https://swetrix-api.example.com/log

# Apollo's Swetrix project id (Project settings in the Swetrix dashboard).
VITE_APOLLO_SWETRIX_PROJECT_ID=
