# Copy this file to .env and fill in real values; .env is gitignored.

#Docker Compose deploy
# The compose stack builds DATABASE_URL from this and starts Postgres with it.
# Generate one:  openssl rand -hex 16
POSTGRES_PASSWORD=

# Local dev (pnpm start, no Docker)
# Used only when running outside the compose stack; the stack overrides these.
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://feeds:feeds@localhost:5432/feeds
PORT=8080

# Public hostname this service is tunneled at; the service DID is did:web:<this>.
SERVICE_HOSTNAME=feeds.sonasky.app

# Token for this stack's cloudflared sidecar. Create it as a "Cloudflared"
# connector tunnel in the Zero Trust dashboard, pointed at
# http://feed-generator:8080 with a public hostname of feeds.sonasky.app.
CLOUDFLARE_TUNNEL_TOKEN=

# Account that owns the app.bsky.feed.generator records (the main SonaSky account).
SONASKY_BSKY_USER=
SONASKY_BSKY_PASS=

# One block per realm defined in @sonasky/labels-def (currently: PRIME, POKEMON).
# {REALM}_OZONE_SERVICE_USER_DID is the labeler DID whose queryLabels we poll.
PRIME_OZONE_SERVICE_USER_DID=
# PRIME_LABELER_URL=          # optional https override; else resolved from the DID doc

POKEMON_OZONE_SERVICE_USER_DID=
# POKEMON_LABELER_URL=

# Days of post history to retain (default 7).
POST_RETENTION_DAYS=7

# Also define/serve a trending feed per species label (default: false). Enabling
# publishes ~845 extra app.bsky.feed.generator records on the next publish run.
TRENDING_PER_SPECIES=false
