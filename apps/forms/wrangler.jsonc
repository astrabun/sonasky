{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonasky-forms",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/f/*", "/api/*", "/oauth/*", "/client-metadata.json", "/jwks.json"],
  },
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "SSKYFORM_OAUTH_STATE",
      "id": "e1d7e92e9adb4392af3169dbd9c1caf6",
      "preview_id": "dd20452e14dd417fb4b9261ed0850491",
    },
    {
      "binding": "SSKYFORM_OAUTH_SESSION",
      "id": "5a063711630e436d9082e421f3d21f46",
      "preview_id": "a9126208595640ce966b25d781e82cf6",
    },
  ],
  "vars": {
    "PUBLIC_URL": "https://forms.sonasky.app",
    "HANDLE_RESOLVER_URL": "https://bsky.social",
  },
}
