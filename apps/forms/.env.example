# Copy to .env (git-ignored) to enable client analytics locally.
#
# Swetrix analytics. Both must be set for analytics to be enabled;
# leave unset (e.g. locally) to disable tracking entirely. These are read at
# Vite build time and baked into the SPA bundle - they are NOT Worker vars.
SWETRIX_BASE_URL=
SWETRIX_PROJECT_ID=
