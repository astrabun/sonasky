# Copy this file to .env and fill in real values; .env is gitignored.

REDIS_URL=redis://localhost:6379

# Token for the cloudflared sidecar that tunnels the cursor-status API
# through Cloudflare Zero Trust. Create it as a "Cloudflared" connector
# tunnel in the Zero Trust dashboard, pointed at http://cursor-status:8080.
CLOUDFLARE_TUNNEL_TOKEN=

# One block per realm defined in @sonasky/labels-def (currently: PRIME, POKEMON).
PRIME_BSKY_USER=
PRIME_BSKY_PASS=

POKEMON_BSKY_USER=
POKEMON_BSKY_PASS=
