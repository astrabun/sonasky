{
  "name": "sonasky",
  "version": "1.0.0",
  "description": "Monorepo of SonaSky Apps/Packages",
  "author": "Astra Bun",
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm -r run typecheck",
    "label-bot:start": "pnpm -F @sonasky/app-label-bot start",
    "cursor-status:start": "pnpm -F @sonasky/app-cursor-status start",
    "label-browser:dev": "pnpm -F @sonasky/app-label-browser dev",
    "feed-generator:start": "pnpm -F @sonasky/app-feed-generator start",
    "feed-generator:migrate": "pnpm -F @sonasky/app-feed-generator migrate",
    "feed-generator:backfill-content-visibility": "pnpm -F @sonasky/app-feed-generator backfill-content-visibility",
    "feed-generator:publish": "pnpm -F @sonasky/app-feed-generator publish-feeds",
    "feed-generator:unpublish": "pnpm -F @sonasky/app-feed-generator unpublish-feeds",
    "feed-generator:purge": "pnpm -F @sonasky/app-feed-generator purge-feeds",
    "feeds-def:gen": "pnpm -F @sonasky/feeds-def gen && oxfmt packages/feeds-def/src/catalog.generated.ts",
    "labels-sync:sync": "pnpm -F @sonasky/labels-sync sync",
    "forms:dev": "pnpm -F @sonasky/app-forms dev",
    "forms:dev:worker": "pnpm -F @sonasky/app-forms dev:worker",
    "forms:build": "pnpm -F @sonasky/app-forms build",
    "forms:deploy": "pnpm -F @sonasky/app-forms deploy",
    "forms:typecheck": "pnpm -F @sonasky/app-forms typecheck",
    "forms:cf-typegen": "pnpm -F @sonasky/app-forms cf-typegen",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "wrangler": "^4.114.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "packages/{labels-def,feeds-def}/src/**": [
      "pnpm feeds-def:gen",
      "git add packages/feeds-def/src/catalog.generated.ts"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.17.0"
}
